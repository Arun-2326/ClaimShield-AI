# ClaimShield AI - Environment Configuration Example
PROJECT_NAME="ClaimShield AI — Pre-Submission Denial Prevention Engine"
VERSION="demo-v1.0"
POLICY_VERSION="routing-v1.0"
MODEL_VERSION="rf-calibrated-v1.0"
RANDOM_SEED=42

# Database (defaults to local SQLite)
DATABASE_URL="sqlite:///./data/claimshield.db"

# Risk Thresholds
RISK_THRESHOLD_LOW_MAX=0.30
RISK_THRESHOLD_MEDIUM_MAX=0.70
MINIMUM_CONFIDENCE_THRESHOLD=0.55

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
